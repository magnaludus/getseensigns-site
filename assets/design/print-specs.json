{
  "schema": 1,
  "about": "True artwork sizes for the online designer, in inches. Every row has a source or a status. status TODO_SPEC means the real number has not been measured yet: a placeholder keeps the preview working and must be replaced from the printer template before print export ships. status UX_DEFAULT means a design choice, not a printer spec. No printer names, links or money figures belong in this file: the repo must not name suppliers. A source of \"printer template\" means the printer's published template or spec page; the list of pages is kept outside the repo.",
  "dpi": {
    "green_min": 150,
    "amber_min": 100,
    "status": "UX_DEFAULT",
    "note": "Badge colors for placed images: green at or above green_min, amber at or above amber_min, red below. Effective dpi = image pixel width / placed width in inches."
  },
  "read_rule": {
    "ft_per_cap_inch": 10,
    "status": "UX_DEFAULT",
    "note": "Sign-industry rule of thumb: about 1 inch of letter height for every 10 ft of viewing distance. Used only for the 'hard to read' note."
  },
