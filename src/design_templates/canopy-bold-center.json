    {"type": "text", "region": "peak", "box": [0.05, 0.7, 0.9, 0.26], "fill": "@accent", "align": "center", "valign": "middle", "fit": {"lines": 1, "max": 14}, "bind": "line2"},
    {"type": "text", "region": "valance", "box": [0, 0, 0.55, 1], "fill": "@primary", "align": "left", "valign": "middle", "fit": {"lines": 1, "max": 9}, "bind": "name", "name": "Valance name"},
    {"type": "text", "region": "valance", "box": [0.55, 0, 0.45, 1], "fill": "@primary", "align": "right", "valign": "middle", "fit": {"lines": 1, "max": 9}, "bind": "phone", "name": "Valance phone"}
  ]
